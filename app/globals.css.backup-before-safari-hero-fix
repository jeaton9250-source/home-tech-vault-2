@import "tailwindcss";

/* ============================================================
   Home Tech Vault Design System 3.2
   Apple simplicity · Sonos warmth · Lutron elegance
   ============================================================ */

@theme inline {
  /* Surfaces — stone & ivory */
  --color-surface-base: #f5f1e8;
  --color-surface-card: #fffdf8;
  --color-surface-sunken: #e7dfd0;
  --color-surface-hover: #eee8dc;

  /* Typography — charcoal warmth */
  --color-text-primary: #17212a;
  --color-text-secondary: #59625d;
  --color-text-muted: #68716c;
  --color-text-tertiary: #8e9690;

  /* Borders — architectural hairlines */
  --color-border-subtle: #ded7ca;
  --color-border-strong: #c9c0b0;

  /* Charcoal — primary actions */
  --color-charcoal: #183047;
  --color-charcoal-hover: #223e58;
  --color-charcoal-soft: #365066;

  /* Interaction — links, focus, progress, selected (never primary buttons) */
  --color-accent: #617c43;
  --color-accent-hover: #718d4f;
  --color-accent-soft: #edf2e7;

  --color-interaction: #617c43;
  --color-interaction-hover: #718d4f;
  --color-interaction-soft: #edf2e7;

  /* Premium — royal plum */
  --color-premium: #40502f;
  --color-premium-hover: #334126;
  --color-premium-soft: #edf1e8;

  /* Home Health — signature emerald */
  --color-home-health: #617c43;
  --color-home-health-hover: #526b38;
  --color-home-health-soft: #edf2e7;
  --color-home-health-muted: #cbd8bb;

  /* Section accents */
  --color-section-technology: #183047;
  --color-section-technology-soft: #e9eef1;
  --color-section-vault: #617c43;
  --color-section-vault-soft: #edf2e7;
  --color-section-network: #40502f;
  --color-section-network-soft: #edf1e8;
  --color-section-insights: #617c43;
  --color-section-insights-soft: #edf2e7;

  /* Status */
  --color-success: #1f5c45;
  --color-success-soft: #ecf6f0;
  --color-warning: #9a6b2f;
  --color-warning-soft: #f9f3e8;
  --color-danger: #b4534b;
  --color-danger-soft: #faefee;
  --color-achievement: #9a6b2f;
  --color-achievement-soft: #f9f3e8;

  /* Radius */
  --radius-card: 24px;
  --radius-button: 12px;
  --radius-input: 12px;
  --radius-dialog: 20px;
  --radius-chip: 9999px;

  /* Shadows — warm layered depth */
  --shadow-sm: 0 1px 2px rgb(28 25 23 / 0.05);
  --shadow-md: 0 4px 20px rgb(28 25 23 / 0.07);
  --shadow-lg: 0 12px 44px rgb(28 25 23 / 0.09);
  --shadow-lift: 0 20px 56px rgb(28 25 23 / 0.1);
  --shadow-inset: inset 0 1px 0 rgb(255 255 255 / 0.75);
  --shadow-well: inset 0 2px 4px rgb(28 25 23 / 0.04);

  /* Motion */
  --ease-premium: cubic-bezier(0.22, 1, 0.36, 1);
  --duration-fast: 160ms;
  --duration-normal: 220ms;

  /* Layout */
  --topbar-height: 68px;
  --content-max: 1280px;

  /* Typography */
  --text-hero: 3rem;
  --text-page-title: 2rem;
  --text-section-title: 1.5rem;
  --text-card-title: 1.125rem;
  --text-body: 1rem;
  --text-label: 0.8125rem;
  --text-caption: 0.75rem;

  --spacing-page: 2rem;
  --spacing-section: 1.5rem;
  --spacing-card: 1.5rem;

  --font-sans: var(--font-geist-sans), ui-sans-serif, system-ui, sans-serif;
}

:root {
  --background: var(--color-surface-base);
  --foreground: var(--color-text-primary);
  --card: var(--color-surface-card);
  --border: var(--color-border-subtle);
}

* {
  box-sizing: border-box;
}

html {
  background: var(--background);
  scroll-behavior: smooth;
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

body {
  min-height: 100vh;
  margin: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-sans);
  font-size: var(--text-body);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

button,
a,
input,
select,
textarea {
  transition:
    background-color var(--duration-fast) var(--ease-premium),
    border-color var(--duration-fast) var(--ease-premium),
    color var(--duration-fast) var(--ease-premium),
    opacity var(--duration-fast) var(--ease-premium),
    box-shadow var(--duration-fast) var(--ease-premium),
    transform var(--duration-normal) var(--ease-premium);
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

input,
select,
textarea {
  color: var(--foreground);
}

input::placeholder,
textarea::placeholder {
  color: var(--color-text-tertiary);
}

::selection {
  background: var(--color-interaction-soft);
  color: var(--color-text-primary);
}

/* Typography */
.text-hero {
  font-size: clamp(2rem, 3.5vw, 3.25rem);
  line-height: 1.12;
  letter-spacing: -0.03em;
  font-weight: 500;
}

.text-page-title {
  font-size: var(--text-page-title);
  line-height: 1.2;
  letter-spacing: -0.02em;
  font-weight: 500;
}

.text-section-title {
  font-size: var(--text-section-title);
  line-height: 1.3;
  letter-spacing: -0.015em;
  font-weight: 500;
}

.text-card-title {
  font-size: var(--text-card-title);
  line-height: 1.4;
  font-weight: 500;
}

.text-label {
  font-size: var(--text-label);
  line-height: 1.25;
  font-weight: 500;
}

.text-caption {
  font-size: var(--text-caption);
  line-height: 1.33;
  color: var(--color-text-muted);
}

.text-overline {
  font-size: 0.6875rem;
  line-height: 1rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.text-link {
  color: var(--color-interaction);
  font-weight: 500;
}

.text-link:hover {
  color: var(--color-interaction-hover);
}

/* Layered surfaces */
.htv-card {
  border-radius: var(--radius-card);
  border: 1px solid var(--color-border-subtle);
  background: var(--color-surface-card);
  box-shadow: var(--shadow-sm);
}

.htv-card-elevated {
  border-radius: var(--radius-card);
  border: 1px solid var(--color-border-subtle);
  background: var(--color-surface-card);
  box-shadow: var(--shadow-sm), var(--shadow-md);
}

.htv-card-interactive {
  transition:
    transform var(--duration-normal) var(--ease-premium),
    box-shadow var(--duration-normal) var(--ease-premium),
    border-color var(--duration-normal) var(--ease-premium);
}

.htv-card-interactive:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md), var(--shadow-lg);
  border-color: var(--color-border-strong);
}

/* Marketing landing — subtle motion */
@keyframes htv-landing-rise {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes htv-preview-enter {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.htv-landing-rise {
  animation: htv-landing-rise 0.55s var(--ease-premium) both;
}

.htv-preview-enter {
  animation: htv-preview-enter 0.4s var(--ease-premium) both;
}

.htv-landing-delay-1 {
  animation-delay: 60ms;
}

.htv-landing-delay-2 {
  animation-delay: 120ms;
}

.htv-landing-delay-3 {
  animation-delay: 180ms;
}

@keyframes htv-landing-pulse {
  0% {
    transform: scale(1);
    opacity: 0.8;
  }

  70% {
    transform: scale(2.2);
    opacity: 0;
  }

  100% {
    transform: scale(2.2);
    opacity: 0;
  }
}

.htv-landing-pulse {
  animation: htv-landing-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@media (prefers-reduced-motion: reduce) {
  .htv-landing-rise,
  .htv-preview-enter {
    animation: none;
    opacity: 1;
    transform: none;
  }

  .htv-landing-pulse {
    animation: none;
    opacity: 0.35;
  }

  .htv-scroll-reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .htv-connector-flow-dot,
  .htv-room-card {
    animation: none;
    transform: none;
  }
}

.htv-scroll-reveal {
  opacity: 0;
  transform: translateY(18px);
  transition:
    opacity 0.65s var(--ease-premium),
    transform 0.65s var(--ease-premium);
}

.htv-scroll-reveal-visible {
  opacity: 1;
  transform: translateY(0);
}

@keyframes htv-connector-flow-dot {
  0% {
    opacity: 0;
    transform: translateY(0) scale(0.8);
  }

  20% {
    opacity: 1;
  }

  100% {
    opacity: 0;
    transform: translateY(28px) scale(1);
  }
}

.htv-connector-flow-dot {
  animation: htv-connector-flow-dot 2.8s var(--ease-premium) infinite;
}

.htv-room-card {
  transition:
    transform 0.35s var(--ease-premium),
    box-shadow 0.35s var(--ease-premium);
}

.htv-room-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
}

@keyframes htv-hero-float {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-6px);
  }
}

.htv-hero-float {
  animation: htv-hero-float 4.5s ease-in-out infinite;
}

@media (prefers-reduced-motion: reduce) {
  .htv-hero-float {
    animation: none;
  }
}

.htv-well {
  border-radius: var(--radius-button);
  border: 1px solid var(--color-border-subtle);
  background: var(--color-surface-sunken);
  box-shadow: var(--shadow-inset);
}

.htv-focus-ring:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px rgb(74 111 165 / 0.22);
}

.htv-input {
  width: 100%;
  border-radius: var(--radius-input);
  border: 1px solid var(--color-border-subtle);
  background: var(--color-surface-card);
  padding: 0.75rem 1rem;
  font-size: 0.875rem;
  color: var(--color-text-primary);
  outline: none;
  box-shadow: var(--shadow-inset);
  transition:
    border-color var(--duration-fast) var(--ease-premium),
    box-shadow var(--duration-fast) var(--ease-premium);
}

.htv-input::placeholder {
  color: var(--color-text-tertiary);
}

.htv-input:focus {
  border-color: var(--color-interaction);
  box-shadow: 0 0 0 3px rgb(74 111 165 / 0.15);
}

.htv-input:disabled {
  cursor: not-allowed;
  background: var(--color-surface-sunken);
  opacity: 0.7;
}

/* Home Command Center hero */
.htv-command-hero {
  background:
    linear-gradient(
      145deg,
      color-mix(in srgb, var(--color-home-health-soft) 85%, white) 0%,
      var(--color-surface-card) 42%,
      var(--color-surface-base) 100%
    );
  border: 1px solid var(--color-border-subtle);
  border-radius: calc(var(--radius-card) + 4px);
  box-shadow:
    var(--shadow-sm),
    var(--shadow-md),
    var(--shadow-inset);
}

/* Metric tile — architectural layered card */
.htv-metric-card {
  border-radius: var(--radius-card);
  border: 1px solid var(--color-border-subtle);
  background: linear-gradient(
    180deg,
    var(--color-surface-card) 0%,
    color-mix(in srgb, var(--color-surface-card) 94%, var(--color-surface-base)) 100%
  );
  box-shadow: var(--shadow-sm), var(--shadow-inset);
  transition:
    transform var(--duration-normal) var(--ease-premium),
    box-shadow var(--duration-normal) var(--ease-premium),
    border-color var(--duration-normal) var(--ease-premium);
}

.htv-metric-card:hover {
  transform: translateY(-2px);
  border-color: var(--color-border-strong);
  box-shadow: var(--shadow-md), var(--shadow-lg);
}

/* Icon well — inset architectural container */
.htv-icon-well {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-button);
  border: 1px solid var(--color-border-subtle);
  background: var(--color-surface-sunken);
  box-shadow: var(--shadow-well), var(--shadow-inset);
}

/* Home arrival hero band */
.htv-hero-band {
  background: linear-gradient(
    135deg,
    var(--color-home-health-soft) 0%,
    var(--color-surface-card) 55%,
    var(--color-surface-base) 100%
  );
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-sm), var(--shadow-md);
}

/* Auth marketing panel — warm residential welcome */
.htv-auth-panel {
  background: linear-gradient(
    145deg,
    var(--color-section-technology-soft) 0%,
    var(--color-surface-card) 45%,
    var(--color-home-health-soft) 100%
  );
  border-right: 1px solid var(--color-border-subtle);
}

/* Premium plan / highlight band */
.htv-plan-band {
  border-bottom: 1px solid var(--color-border-subtle);
  background: linear-gradient(
    135deg,
    var(--color-section-insights-soft) 0%,
    var(--color-surface-card) 55%,
    var(--color-surface-base) 100%
  );
}

/* ============================================================
   Apple Home OS & Glass Primitives
   ============================================================ */

.htv-glass-card {
  border-radius: var(--radius-card);
  border: 1px solid rgba(231, 226, 218, 0.7);
  background: rgba(253, 252, 250, 0.82);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  box-shadow:
    0 4px 20px rgb(28 25 23 / 0.04),
    inset 0 1px 0 rgb(255 255 255 / 0.8);
}

.htv-glass-card-elevated {
  border-radius: var(--radius-card);
  border: 1px solid rgba(231, 226, 218, 0.8);
  background: rgba(253, 252, 250, 0.9);
  backdrop-filter: blur(32px);
  -webkit-backdrop-filter: blur(32px);
  box-shadow:
    0 12px 40px -10px rgb(28 25 23 / 0.08),
    inset 0 1px 0 rgb(255 255 255 / 0.9);
}

.htv-glass-pill {
  border-radius: var(--radius-chip);
  border: 1px solid rgba(231, 226, 218, 0.8);
  background: rgba(253, 252, 250, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 2px 12px rgb(28 25 23 / 0.04);
}

/* Ambient Status Lighting Halos */
.htv-ambient-emerald {
  position: relative;
}
.htv-ambient-emerald::before {
  content: "";
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  background: radial-gradient(
    600px circle at var(--x, 50%) var(--y, 0%),
    rgba(31, 92, 69, 0.08),
    transparent 70%
  );
  pointer-events: none;
}

.htv-ambient-plum {
  position: relative;
}
.htv-ambient-plum::before {
  content: "";
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  background: radial-gradient(
    600px circle at var(--x, 50%) var(--y, 0%),
    rgba(74, 53, 97, 0.08),
    transparent 70%
  );
  pointer-events: none;
}

.htv-ambient-gold {
  position: relative;
}
.htv-ambient-gold::before {
  content: "";
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  background: radial-gradient(
    600px circle at var(--x, 50%) var(--y, 0%),
    rgba(154, 107, 47, 0.08),
    transparent 70%
  );
  pointer-events: none;
}

.htv-mesh-hero-bg {
  background-color: #faf9f7;
  background-image:
    radial-gradient(at 15% 15%, rgba(236, 246, 240, 0.85) 0px, transparent 50%),
    radial-gradient(at 85% 20%, rgba(243, 238, 248, 0.75) 0px, transparent 50%),
    radial-gradient(at 50% 80%, rgba(238, 241, 246, 0.7) 0px, transparent 50%);
}



/* Fixed homeowner hero layout */
.htv-home-hero-layout {
  display: grid;
  grid-template-columns: minmax(0, 42%) minmax(0, 58%);
  align-items: center;
  gap: clamp(2rem, 4vw, 4rem);
}

.htv-home-hero-layout > * {
  min-width: 0;
}

/*
 * Only stack the homeowner hero on genuinely small screens.
 * This intentionally does not rely on Tailwind breakpoints.
 */
@media (max-width: 650px) {
  .htv-home-hero-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
}

