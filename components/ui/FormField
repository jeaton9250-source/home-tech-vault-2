import {
  InputHTMLAttributes,
  TextareaHTMLAttributes,
} from "react";

import { cn } from "@/lib/design-system/cn";

type BaseProps = {
  label: string;
  error?: string;
  helpText?: string;
};

type InputProps = BaseProps & {
  multiline?: false;
} & InputHTMLAttributes<HTMLInputElement>;

type TextareaProps = BaseProps & {
  multiline: true;
} & TextareaHTMLAttributes<HTMLTextAreaElement>;

type FormFieldProps = InputProps | TextareaProps;

export default function FormField(
  props: FormFieldProps
) {
  const {
    label,
    error,
    helpText,
    multiline,
    className = "",
    ...fieldProps
  } = props;

  const fieldClasses = cn(
    "w-full rounded-[var(--radius-input)] border bg-surface-card px-4 py-3 text-text-primary outline-none transition-colors",
    error
      ? "border-danger focus:border-danger focus:ring-2 focus:ring-danger/15"
      : "border-border-subtle focus:border-accent focus:ring-2 focus:ring-accent/15",
    className
  );

  return (
    <label className="block">
      <span className="text-label mb-2 block text-text-primary">
        {label}
      </span>

      {multiline ? (
        <textarea
          {...(fieldProps as TextareaHTMLAttributes<HTMLTextAreaElement>)}
          className={cn(
            fieldClasses,
            "min-h-28 resize-y"
          )}
        />
      ) : (
        <input
          {...(fieldProps as InputHTMLAttributes<HTMLInputElement>)}
          className={fieldClasses}
        />
      )}

      {error ? (
        <span className="mt-2 block text-sm text-danger">
          {error}
        </span>
      ) : helpText ? (
        <span className="mt-2 block text-sm text-text-tertiary">
          {helpText}
        </span>
      ) : null}
    </label>
  );
}
