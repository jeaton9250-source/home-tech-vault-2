{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Home Tech Vault Connector",
  "version": "0.1.0",
  "identifier": "com.hometechvault.connector",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Home Tech Vault Connector",
        "width": 520,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* https://hometechvault.com https://*.hometechvault.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:"}
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "publisher": "Home Tech Vault",
    "copyright": "Copyright © Home Tech Vault",
    "shortDescription": "Discover and monitor devices on your home network.",
    "longDescription": "The Home Tech Vault Connector discovers devices on your private home network and keeps your vault synchronized.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "both"
      }
    }
  },
 "plugins": {}
}